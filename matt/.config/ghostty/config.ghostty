font-family = IBM Plex Mono
font-feature = +zero
font-size = 12
font-style = "Semibold"

bell-features = no-system,no-audio

window-padding-x = 8
window-padding-y = 12
confirm-close-surface = always
macos-titlebar-style = native
macos-non-native-fullscreen = false
unfocused-split-opacity = 1
window-vsync = false

tab-inherit-working-directory = true
split-inherit-working-directory = true

# Kitty's Shift+Arrow pane-moving shortcuts have no Ghostty equivalent.
keybind = super+left=goto_split:left
keybind = super+right=goto_split:right
keybind = super+up=goto_split:up
keybind = super+down=goto_split:down
keybind = super+enter=new_split:auto
keybind = super+t=new_tab

config-file = theme.conf
